{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SonarQube",
          "rules": [
            {
              "properties": {
                "id": "java:S106",
                "name": "Standard outputs should not be used directly to log anything"
              }
            }
          ]
        }
      },
      "results": [
        {
          "rule": { "id": "java:S106" },
          "level": "warning",
          "message": { "text": "Replace this use of System.out by a logger." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "A.java" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
