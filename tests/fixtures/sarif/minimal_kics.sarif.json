{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "KICS",
          "rules": [
            {
              "id": "s3-bucket-public",
              "shortDescription": { "text": "S3 bucket is public" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "s3-bucket-public",
          "level": "high",
          "message": { "text": "Bucket allows public access" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///ABS/ROOT/terraform/main.tf"
                },
                "region": { "startLine": 1 }
              }
            }
          ]
        },
        {
          "ruleId": "outside-root",
          "level": "high",
          "message": { "text": "Path leaves the repository" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "../escape.tf" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
