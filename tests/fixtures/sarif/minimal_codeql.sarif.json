{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "py/clear-text-logging",
              "properties": {
                "tags": ["security"],
                "description": "Clear-text logging of sensitive data"
              }
            }
          ]
        }
      },
      "results": [
        {
          "rule": { "id": "py/clear-text-logging" },
          "level": "error",
          "message": { "text": "Sensitive data logged in clear text" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///ABS/ROOT/src/leak.py"
                },
                "region": { "startLine": 12 }
              }
            }
          ]
        }
      ]
    }
  ]
}
