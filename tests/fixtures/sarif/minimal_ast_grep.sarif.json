{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ast-grep",
          "rules": [
            {
              "id": "no-eval",
              "shortDescription": { "text": "Avoid eval" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "no-eval",
          "level": "error",
          "message": { "text": "eval executes untrusted text" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///ABS/ROOT/src/app.py"
                },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
