{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.dev/schemas/architecture.schema.json",
  "title": "RepoLensArchitecture",
  "type": "object",
  "required": ["boundaries"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Glob matched against module paths (packcycle/a) and dotted names"
          },
          "allowed_imports": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
